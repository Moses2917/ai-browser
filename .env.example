# AI Browser Configuration
# Copy this file to .env and add your keys (optional - LM Studio doesn't need keys!)

# LM Studio (Local AI) - No key needed!
# Just start LM Studio and load a model
LM_STUDIO_URL=http://localhost:1234/v1

# Optional: Anthropic Claude (only if you want cloud AI with vision)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: OpenAI (only if you want GPT-4)
# Get yours at: https://platform.openai.com/
OPENAI_API_KEY=your-openai-key-here

# Alternative local AI (if not using LM Studio)
# OLLAMA_URL=http://localhost:11434/v1
# LOCALAI_URL=http://localhost:8080/v1
